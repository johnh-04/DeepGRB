# ----------------------------------------------------------------------------- Python / tools
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints
.pytest_cache/
.mypy_cache/
.idea/
.vscode/
.DS_Store
.env
.venv
*.log
*.tar.gz
logs/

# ----------------------------------------------------------------------------- data (see data/README.md)
# raw and preprocessed inputs, shared by all periods (~26 GB)
data/cspec/
data/poshist/
data/bkg/
data/*.pha
data/*.fit
data/*.fits
data/plots/
data/grb_classification/
# outputs of the old layout (kept on disk, not versioned)
data/pred/
data/trig/
data/results/
data/fermi_triggers_sandbox_jan2019.csv
# Burst Catalog database (10 MB): rebuilt from HEASARC with connections/fermi_data_tools.py
data/gbm_burst_catalog.db

# models: weights and scalers are not versioned, only the bundle metadata
data/nn_model/*
!data/nn_model/bundles/
data/nn_model/bundles/*/*
!data/nn_model/bundles/*/metadata.json

# runs: the large matrices of steps 3-4 are not versioned (manifest, RESULTS.md, results/,
# validation/ and analysis/ are)
data/runs/*/*/pred
data/runs/*/*/trig

# archives: only README and checksums are versioned
data/_archive_*/*
!data/_archive_*/README.md
!data/_archive_*/SHA256SUMS*

# ----------------------------------------------------------------------------- old layout, kept on disk only
data_test/
connections/utils/m_check/
benchmark/out/
benchmark/analysis/out/
models/tests/
